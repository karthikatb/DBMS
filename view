CREATE VIEW bank_head_office AS
SELECT *
FROM BANK_49
WHERE headoffice = 'Ernakulam';
select * from bank_head_office;
DROP VIEW bank_branch;
SELECT * FROM BANK_49;
SELECT * FROM bank_outside_ernakulam;

CREATE VIEW bank_branch AS
SELECT B.*
FROM BANK_49 B
JOIN BRANCH BR ON B.bankcode = BR.bankid
WHERE BR.branchname = 'Kottayam';
select * from bank_branch;

CREATE VIEW bank_more_than_50 AS SELECT * FROM BANK_49 WHERE branches>50;


CREATE VIEW bank_branch_details AS SELECT b.bankname, br.branchname FROM BANK_49 b JOIN Branch br ON b.bankcode=br.bankid;

CREATE VIEW bank_outside_ernakulam AS SELECT * FROM BANK_49 WHERE headoffice<>'Ernakulam';
